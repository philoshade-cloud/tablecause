"profiles":[{"id":"794784e0-e090-4747-832d-f9899a8667ec","handle":"maya-okafor","display_name":"Maya Okafor","headline":"Founder, Rootline (soil sensors for small farms)","bio":"I left a hardware job in 2024 to build low-cost soil moisture sensors for farms under 20 acres. We have 40 pilot farms in the Central Valley and a working v2 board. I host dinners to meet people who care about food and the land, and to fund our next production run.","avatar_url":null,"home_city":"Oakland, CA","id_verified":true,"linked_channels":[{"type":"linkedin","label":"LinkedIn","verified":true},{"type":"youtube","label":"YouTube, 18K subscribers","verified":true}],"is_sample":true},{"id":"7d92d5b2-3eb9-44a5-838a-0256d2f4de2e","handle":"tom-ashby","display_name":"Tom Ashby","headline":"Documentary filmmaker","bio":"I make short documentaries about coastal towns in the north of England. My current film follows the last three boat builders in Whitby. These dinners help cover the edit and a festival submission.","avatar_url":null,"home_city":"Leeds, UK","id_verified":true,"linked_channels":[{"type":"instagram","label":"Instagram, 42K followers","verified":true}],"is_sample":true},{"id":"6de43d3a-5c0e-4773-bd79-409e83c41c13","handle":"priya-raman","display_name":"Priya Raman","headline":"Children's author and illustrator","bio":"Author of four picture books. I'm running a reading program in Scarborough libraries this winter and host small dinners to fund books for kids who don't have any at home.","avatar_url":null,"home_city":"Toronto, ON","id_verified":true,"linked_channels":[{"type":"x","label":"X, 9K followers","verified":true},{"type":"website","label":"Personal website","verified":true}],"is_sample":true}],
"events":[{"id":"95f4e6cb-67ef-49f5-a1eb-0b92b567d514","short_code":"rt4k2m","host_id":"794784e0-e090-4747-832d-f9899a8667ec","title":"Dinner with Rootline: the next 200 sensors","summary":"A long table in Oakland with the team building soil sensors for small farms.","story":"We're ordering our second production run of 200 sensors in January. This dinner is a chance to see the hardware, hear what 40 farms taught us, and ask anything about building a hardware startup without a big raise. Every seat helps pay for parts.","cause_type":"personal","category_id":28,"tags":["agtech","hardware"],"use_of_funds":[{"label":"Sensor components for 200 units","percent":70},{"label":"Field installation trips","percent":20},{"label":"Packaging and shipping","percent":10}],"commitments":["Maya stays for the full dinner (6:30 to 9:30 pm)","Live demo of the v2 sensor board","Open Q&A on starting a hardware company","Every guest gets a project update in March"],"image_url":"https://images.unsplash.com/photo-1528605248644-14dd04022da1?w=1600&q=80","starts_at":"2026-11-21T02:30:00+00:00","ends_at":"2026-11-21T05:30:00+00:00","timezone":"America/Los_Angeles","country":"US","city":"Oakland","neighborhood":"Temescal","venue_type":"commercial","capacity":16,"currency":"usd","min_contribution":12000,"go_threshold_type":"guests","go_threshold_value":8,"go_deadline":"2026-11-14T02:30:00+00:00","host_fee_type":"percent","host_fee_value":10,"est_meal_value":null,"alcohol":"venue","min_age":18,"status":"open","seats_taken":11,"amount_pledged":141000,"is_sample":true},{"id":"fcb9125c-7a80-4c2d-8974-4c93f3a59637","short_code":"wb7h3n","host_id":"7d92d5b2-3eb9-44a5-838a-0256d2f4de2e","title":"The last boat builders of Whitby: a screening supper","summary":"Watch a rough cut, then eat and talk about how small towns keep their crafts.","story":"Over two years I filmed the last three wooden boat builders in Whitby. I'll show a 25-minute rough cut, then we'll eat together and I want your honest notes. Money raised covers the final edit, sound mix and festival fees.","cause_type":"personal","category_id":24,"tags":["documentary","craft"],"use_of_funds":[{"label":"Final edit and colour","percent":50},{"label":"Sound mix","percent":30},{"label":"Festival submissions","percent":20}],"commitments":["Screening of a 25-minute rough cut","Tom stays for the whole evening","Guests are thanked by name in the credits (optional)","Link to the finished film when it's out"],"image_url":"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1600&q=80","starts_at":"2026-11-28T19:00:00+00:00","ends_at":"2026-11-28T22:00:00+00:00","timezone":"Europe/London","country":"GB","city":"Leeds","neighborhood":"Chapel Allerton","venue_type":"commercial","capacity":20,"currency":"gbp","min_contribution":6500,"go_threshold_type":"total","go_threshold_value":80000,"go_deadline":"2026-11-21T19:00:00+00:00","host_fee_type":"percent","host_fee_value":15,"est_meal_value":null,"alcohol":"venue","min_age":18,"status":"open","seats_taken":9,"amount_pledged":62000,"is_sample":true},{"id":"315f39f6-4975-4b20-909d-e7f2f4314fb6","short_code":"pr9s5d","host_id":"6de43d3a-5c0e-4773-bd79-409e83c41c13","title":"Story night supper for the Scarborough reading program","summary":"A home-cooked South Indian dinner, a reading, and books for kids who have none.","story":"This winter I'm running a free reading program in four Scarborough library branches. Each child takes home five books to keep. I'll cook dinner at home, read from my new book, and tell you how the program works. Funds buy the books.","cause_type":"community","category_id":12,"tags":["literacy","books"],"use_of_funds":[{"label":"Books for 120 children (5 each)","percent":85},{"label":"Reading kits and bookmarks","percent":15}],"commitments":["Home-cooked dinner by Priya","Reading from her upcoming book","Photo update from the program in February"],"image_url":"https://images.unsplash.com/photo-1600891964092-4316c288032e?w=1600&q=80","starts_